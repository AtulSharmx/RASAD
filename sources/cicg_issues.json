{
  "id": "cicg_issues",
  "name": "Daily issues / consumption (CICG-like export)",
  "owner": "Army inventory system - daily export",
  "simulated": true,
  "target": "consumption",
  "format": "csv",
  "path": "data/feeds/cicg_issues.csv",
  "map": {"date": "ISSUE_DT", "post": "UNIT_LOC_CODE", "class": "ITEM_CAT", "qty": "QTY_ISSUED", "strength": "RATION_STR"},
  "value_map": {"class": {"RAT": "rations", "SKO": "kerosene", "MED": "medical", "BAT": "batteries_spares", "WCL": "winter_clothing"}},
  "time_field": "date",
  "stale_after_hours": 48
}
